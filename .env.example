# BerrelEye — AI Cost Optimization Gateway
# "Cloudflare for LLM cost optimization" (internal mental model, not branding)

DATABASE_URL=postgres://berreleye:berreleye@localhost:5432/berreleye?sslmode=disable
REDIS_URL=redis://localhost:6379/0
ML_SERVICE_URL=http://localhost:8001

# Gateway
PORT=8080
# Browser origin allowed to call the dashboard API (comma-separated list not supported yet).
CORS_ORIGIN=http://localhost:3000
# Set true when the dashboard is served over HTTPS in production.
COOKIE_SECURE=false
ENCRYPTION_KEY=change-me-32-byte-base64-key-AAAAAAAAAAAAAAAAAAAAAA==
# 32-byte key, base64 encoded. Generate with: openssl rand -base64 32

# Dashboard API base URL (server-side only; never expose provider keys here)
GATEWAY_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Seed / demo
SEED_DEMO=true
DEMO_ORG_SLUG=demo

# Provider keys (server-side only, never NEXT_PUBLIC_)
# Leave empty for local dev — gateway runs in mock-provider mode and still
# records real usage/cost/routing rows. Set real keys to hit real providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
